# Non-secret process configuration. Copy to .env for docker compose.
# Secrets are never stored here: generate them into the ignored .secrets/
# directory (see docker-compose.yml header).

HOOKRELAY_ENVIRONMENT=development
# Host uid/gid for the hookrelay container (compose file secrets are 0600
# and owned by the host user).
# HOOKRELAY_CONTAINER_UID=1000
# HOOKRELAY_CONTAINER_GID=1000
# HOOKRELAY_PUBLIC_ADDRESS=0.0.0.0:8080
# HOOKRELAY_ADMIN_ADDRESS=127.0.0.1:8081
# HOOKRELAY_LOG_LEVEL=info
# HOOKRELAY_ADMIN_ORIGIN=http://127.0.0.1:8081
# HOOKRELAY_ADMIN_COOKIE_SECURE=false
# HOOKRELAY_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# HOOKRELAY_TELEGRAM_SOURCE_CIDRS=

# Webhook ingestion protections (defaults shown; a zero rate disables a limit
# in development, production requires nonzero rates).
# HOOKRELAY_WEBHOOK_GLOBAL_RATE=0
# HOOKRELAY_WEBHOOK_GLOBAL_BURST=0
# HOOKRELAY_WEBHOOK_ENDPOINT_RATE=0
# HOOKRELAY_WEBHOOK_ENDPOINT_BURST=0
# HOOKRELAY_MAX_INFLIGHT_WEBHOOKS=100

# Queue capacity and retention (production requires HOOKRELAY_EXPECTED_PEAK_RATE).
# HOOKRELAY_MAX_QUEUED_MESSAGES=100000
# HOOKRELAY_MAX_QUEUED_MESSAGES_PER_RECIPIENT=1000
# HOOKRELAY_MEMORY_ACCEPTANCE_STOP_PERCENT=90
# HOOKRELAY_DEDUP_RETENTION=168h
# HOOKRELAY_DEDUP_MIN_RETENTION=24h
# HOOKRELAY_MAX_DEDUP_RECORDS=1000000
# HOOKRELAY_EXPECTED_PEAK_RATE=
# HOOKRELAY_DLQ_RETENTION=720h

# Leases and retries.
# HOOKRELAY_INITIAL_LEASE_DURATION=60s
# HOOKRELAY_LEASE_EXTENSION_DURATION=60s
# HOOKRELAY_MAX_LEASE_LIFETIME=5m
# HOOKRELAY_MAX_DELIVERY_ATTEMPTS=4
# HOOKRELAY_RETRY_DELAYS=1s,5s,30s
# HOOKRELAY_RETRY_JITTER_MIN=0.5
# HOOKRELAY_RETRY_JITTER_MAX=1.0
# HOOKRELAY_MAX_ACTIVE_LEASES=100
# HOOKRELAY_MAX_WAITING_CLAIMS=20

# Background maintenance (lease expiry, retry activation, DLQ retention).
# HOOKRELAY_MAINTENANCE_INTERVAL=1s
# HOOKRELAY_MAINTENANCE_INTERVAL_JITTER=250ms
# HOOKRELAY_MAINTENANCE_BATCH_SIZE=100
# HOOKRELAY_MAINTENANCE_MAX_CONTINUOUS_BATCHES=5

# Valkey client resources.
# HOOKRELAY_VALKEY_MAX_CONNECTIONS=20
# HOOKRELAY_VALKEY_MIN_IDLE=2
